# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data: learner progress and its backups are private and never committed.
# course.db (read-only content built by the course pipeline) IS committed so the server can deploy from git.
/data/*
!/data/course.db
*.db-journal
*.db-wal
*.db-shm

# local tool caches
.impeccable/hook.cache.json

# but keep the template
!.env.example
