# Copy to .env.local (local dev, git-ignored) or to the server's secrets file (see DEPLOY.md). Never commit real values.
# Generate a secret with: openssl rand -base64 48
APP_PASSWORD=
OWNER_PASSWORD=
AUTH_SECRET=
# Production: the public origin, used for login redirects behind the reverse proxy.
# APP_ORIGIN=https://camino.sabarca.dev
# Optional outside Docker: where progress.db and backups live (default ./data). Docker always uses /data.
# DATA_DIR=/var/lib/camino
